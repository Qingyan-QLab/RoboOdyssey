  "record_video": true,
  "video_layout": "front_overview",
  "video_fps": 4,
  "video_event_seconds": 0.25,
  "ffmpeg": "ffmpeg",
  "environment": {},
  "model_service": {
    "mode": "managed",
    "gpu_uuid": "GPU-replace-with-model-device-UUID",
    "startup_timeout": 600,
    "extra_args": [
      "--use_bf16",
      "--idle_timeout",
      "3600"
    ],
    "environment": {
      "OMP_NUM_THREADS": "4"
    }
  },
  "auto_analyze": true,
  "sequences": [
    "seq_0001"
  ]
