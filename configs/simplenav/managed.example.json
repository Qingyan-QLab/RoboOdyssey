{
  "dataset": "../../../OSS/scene000010/session.tar",
  "simplenav_root": "/path/to/SimpleNav",
  "checkpoint": "/path/to/checkpoints/steps_8000_pytorch_model.pt",
  "agent_python": "/path/to/simplenav/environment/bin/python",
  "isaac_python": "/path/to/isaacsim/python.sh",
  "output": "../../results",
  "url": "ws://127.0.0.1:10193",
  "unnorm_key": "vln_train_train",
  "max_steps": 2000,
