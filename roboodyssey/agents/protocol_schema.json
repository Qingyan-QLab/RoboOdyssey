{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Long-Term Benchmark Agent Protocol v1.1 response (v1.0 action-body compatible)",
  "type": "object",
  "properties": {
    "request_id": {"type": "string"},
    "observation_stream_ack": {"type": "boolean"},
    "observation_frame_id": {"type": "integer", "minimum": 1},
    "agent_status": {"enum": ["ok", "unsupported", "integration_error"]},
    "reason_code": {"type": "string", "minLength": 1}
  },
  "if": {"required": ["agent_status"], "properties": {"agent_status": {"enum": ["unsupported", "integration_error"]}}},
  "then": {"required": ["reason_code"]},
  "oneOf": [
    {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "oneOf": [
            {"enum": ["no_op", "move_forward", "move_backward", "move_left", "move_right", "turn_left", "turn_right", "look_up", "look_down", "pick", "place", "open", "close", "reset"]},
            {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": {"enum": ["no_op", "move_forward", "move_backward", "move_left", "move_right", "turn_left", "turn_right", "look_up", "look_down", "pick", "place", "open", "close", "reset"]},
                "distance": {"type": "number"},
                "angle_degrees": {"type": "number"},
                "object_id": {"type": "string"},
                "target": {"type": "string"},
                "room_id": {"type": "string"}
              },
              "additionalProperties": true
            }
          ]
        },
        "done": {"type": "boolean"},
        "memory_update": {"type": "object"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "not": {"required": ["action"]},
      "anyOf": [{"required": ["answer"]}, {"required": ["prediction"]}],
      "properties": {
        "answer": {},
        "prediction": {},
        "memory_update": {"type": "object"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "not": {"anyOf": [{"required": ["action"]}, {"required": ["answer"]}, {"required": ["prediction"]}]},
      "properties": {
        "ok": {"type": "boolean"},
        "memory_update": {"type": "object"}
      },
      "additionalProperties": true
    }
  ]
}
